apiVersion: v1
kind: Secret
metadata:
  name: kafka-creds
  namespace: kafka-cluster
type: Opaque
stringData:
  credentials: |
    {
      "brokers": [
        "kafka-0.kafka-headless:9092"
      ],
      "connect": {
        "url": "https://connect-api.kafka-cluster.svc:8083",
        "basicAuth": {
          "username": "connect-admin",
          "password": "password123"
        },
        "tls": {
          "caCertificateSecretRef": {
            "name": "connect-ca",
            "namespace": "kafka-cluster"
          }
        }
      }
    }
